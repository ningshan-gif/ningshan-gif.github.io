---
layout: null
permalink: /room-posts.json
---
{% assign audios = site.static_files | where_exp: "f", "f.path contains '/audio/'" %}{% assign igs = site.static_files | where_exp: "f", "f.path contains '/images/instagram/'" %}{
"audio": [{% for f in audios %}{{ f.basename | jsonify }}{% unless forloop.last %},{% endunless %}{% endfor %}],
"music": {% if site.data.post_music %}{{ site.data.post_music | jsonify }}{% else %}null{% endif %},
"gallery": [{% for f in igs %}{{ f.path | jsonify }}{% unless forloop.last %},{% endunless %}{% endfor %}],
"posts": [
{% for post in site.posts %}  {"title": {{ post.title | jsonify }}, "url": {{ post.url | jsonify }}, "date": {{ post.date | date: "%b %-d, %Y" | jsonify }}, "ts": {{ post.date | date: "%s" }}, "image": {{ post.image | jsonify }}, "tags": {{ post.tags | jsonify }}, "excerpt": {{ post.excerpt | strip_html | strip_newlines | truncate: 420 | jsonify }}, "body": {% if post.tags contains "instagram" %}""{% else %}{{ post.content | strip_html | jsonify }}{% endif %}}{% unless forloop.last %},{% endunless %}
{% endfor %}]
}
